# Reel2Short — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control.

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database (SQLite — path relative to project root)
DATABASE_URL=sqlite:///./reel2short.db

# Storage (relative to project root)
STORAGE_DIR=./storage

# ─────────────────────────────────────────────────────
# Instagram API (Stage 1)
# ─────────────────────────────────────────────────────
# Obtain from: https://developers.facebook.com/
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback

# Long-lived Instagram access token (generated once)
INSTAGRAM_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────
# Google / YouTube OAuth (Stage 3)
# ─────────────────────────────────────────────────────
# Obtain from: https://console.cloud.google.com/
# Required APIs: YouTube Data API v3
# OAuth type: Web Application
# Authorized redirect URIs: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─────────────────────────────────────────────────────
# FFmpeg (Stage 2)
# ─────────────────────────────────────────────────────
# Leave blank if ffmpeg/ffprobe are on PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─────────────────────────────────────────────────────
# Redis / Worker (Stage 2–3)
# ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
WORKER_STALE_JOB_TIMEOUT_SECONDS=300

# ─────────────────────────────────────────────────────
# Storage Lifecycle (Stage 3)
# ─────────────────────────────────────────────────────
# How long to retain files for failed uploads before cleanup
TEMP_VIDEO_RETENTION_HOURS=24

# ─────────────────────────────────────────────────────
# Stage 4 — AI + Scheduling
# ─────────────────────────────────────────────────────
# AI metadata generation via Gemini
# Get a free key at: https://aistudio.google.com/
# Leave AI_API_KEY blank to disable AI features.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Default timezone shown in the scheduling UI
# IANA timezone name: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
DEFAULT_TIMEZONE=Asia/Kolkata
